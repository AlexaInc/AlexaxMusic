# Alexa Music environment example
# Copy to .env, replace every REQUIRED value, and never commit the real .env.

# -----------------------------------------------------------------------------
# REQUIRED: Telegram and MongoDB
# -----------------------------------------------------------------------------
API_ID=12345678
API_HASH=replace_with_api_hash
BOT_TOKEN=1234567890:replace_with_bot_token
MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net/alexamusic
MONGO_DB_NAME=Alexa
LOGGER_ID=-1001234567890
OWNER_ID=123456789
SESSION=replace_with_pyrogram_v2_string_session

# Optional assistant accounts (Pyrogram string sessions)
SESSION2=
SESSION3=

# -----------------------------------------------------------------------------
# Bot behavior
# -----------------------------------------------------------------------------
PORT=7860
# Values are minutes/items, matching config.py.
DURATION_LIMIT=60
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20
AUTO_END=false
AUTO_LEAVE=false
VIDEO_PLAY=true
MUSIC_BOT_NAME=Alexa Music
SUPPORT_CHANNEL=https://t.me/AlexaInc_updates
SUPPORT_CHAT=https://t.me/+_9LokVOOdrdlOGQ1
DEFAULT_THUMB=https://te.legra.ph/file/3e40a408286d4eda24191.jpg
PING_IMG=https://files.catbox.moe/haagg2.png
START_IMG=https://files.catbox.moe/zvziwk.jpg

# Optional Telegram MTProto proxy. Supported schemes: http, socks4, socks5.
# Example: socks5://username:password@proxy.example.com:1080
PROXY_URL=

# -----------------------------------------------------------------------------
# ytdlgo 1.0.0 — ALL YouTube media downloads use this backend
# Release: https://github.com/AlexaInc/ytdlgo/releases/tag/1.0.0
# Docker sets the absolute binary paths. For a local install, leaving these empty
# uses <project>/bin/ytdl and adds <project>/bin to PATH.
# -----------------------------------------------------------------------------
YTDL_BIN=
YTDL_BIN_DIR=
YTDL_DISABLE=0
YTDL_CONCURRENCY=1
YTDL_COMMAND_TIMEOUT=900
YTDL_BOTCHECK_BACKOFF=900
DOWNLOAD_DIR=downloads
WORK_DIR=/tmp/ytdl-work

# ytdlgo-compatible HTTP relays, comma separated. These match alexa-v3's
# proven fallback chain. Set YTDL_RELAYS=none to require local-only downloads.
YTDL_RELAYS=https://absolute-vonnie-alexainc-ec756816.koyeb.app,https://hansaka1-ytdl.hf.space,https://cold-lemming-3841.alexainc.deno.net
YTDL_RELAY_KEY=
YTDL_RELAY_TIMEOUT=420

# Retry format/client failures through the same ytdlgo binary. The cookie-less
# retry helps when a stale cookie exposes only storyboards or limited formats.
YTDL_FORMAT_RETRY=true
YTDL_COOKIELESS_RETRY=true
YTDL_RETRY_CLIENTS=default,android,mweb

# ytdlgo tool paths. Bare names are resolved through PATH.
YTDLP_BIN=yt-dlp
DENO_BIN=deno
FFMPEG_BIN=ffmpeg
XET_UPLOAD_BIN=xet-upload

# Download format and limits consumed by ytdlgo. alexa-v3 uses mp3, which is
# more tolerant when YouTube offers only a combined audio/video format.
# Supported values: native, mp3, opus.
YTDL_AUDIO_FORMAT=mp3
AUDIO_BITRATE=128k
MAX_HEIGHT=720
MAX_DURATION_SEC=3600
YT_CLIENTS=default,mweb,android

# Optional proxy used only by yt-dlp. This is separate from PROXY_URL above.
YTDLP_PROXY=

# -----------------------------------------------------------------------------
# Cookies (recommended when YouTube bot checks affect the host)
# -----------------------------------------------------------------------------
# Comma- or newline-separated HTTPS URLs to Netscape-format cookie files.
# ytdlgo downloads, rotates, and refreshes these files. Keep cookie URLs secret.
COOKIES_URLS=
COOKIES_REFRESH_MIN=60

# Deprecated compatibility variable (space/comma separated). Prefer COOKIES_URLS.
COOKIES_URL=

# -----------------------------------------------------------------------------
# Optional Hugging Face Storage Bucket cache
# -----------------------------------------------------------------------------
# Leave both empty to keep each ytdlgo result local. For a bucket, use the
# owner/bucket form and a token that can read/write that bucket.
HF_BUCKET=
HF_TOKEN=
